---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Wraps around, so the navigator is never a dead end on the last one.
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const facts = [
  { label: 'Role', values: [d.role] },
  { label: 'Context', values: [d.context] },
  { label: 'Stack', values: d.stack },
  ...(d.systems.length ? [{ label: 'Systems', values: d.systems }] : []),
  { label: 'Outcome', values: [d.outcome] },
];
---

<Base title={d.title} description={d.thesis}>
  <article class="case">
    <div class="shell">
      {/* Points at this project's own row, not just the section top — lands
          back where the visitor actually was rather than at the top of the
          list. See WorkRow.astro for the matching id on each row. */}
      <a class="case__back t-mono" href={`/#${project.id}`}>
        <span aria-hidden="true">&#8592;</span> All work
      </a>

      <header class="case__head">
        <p class="case__eyebrow t-mono">
          <span class="case__discipline">{d.discipline}</span>
          <span class="case__slash" aria-hidden="true">/</span>
          <span>{d.context}</span>
        </p>
        <h1 class="case__title t-h1">{d.title}</h1>
        <p class="case__tagline t-lead">{d.tagline}</p>
      </header>

      <figure class="case__cover">
        {/* Paired with the same name on the home page card. That card
            (.work__media) is always sized tightly to the cover's own aspect
            ratio, with no letterboxing — putting the name on this frame
            (sized the same way, rather than on the wide, height-capped
            .case__cover box below) keeps the two ends of the morph the same
            shape throughout, instead of the image content snapping to its
            letterboxed layout the moment the transition starts. */}
        <div
          class="case__cover-frame"
          style={`view-transition-name: cover-${project.id}; --arn: ${(d.cover.width / d.cover.height).toFixed(4)}`}
        >
          <Image
            src={d.cover}
            alt={d.coverAlt}
            widths={[640, 1000, 1500]}
            sizes="(min-width: 78rem) 74rem, 94vw"
            loading="eager"
            fetchpriority="high"
            class="case__cover-img"
          />
        </div>
      </figure>

      <div class="case__body">
        <div class="prose">
          <Content />
        </div>

        <aside class="case__facts">
          <dl>
            {
              facts.map((f) => (
                <div class="fact">
                  <dt class="t-mono">{f.label}</dt>
                  <dd>
                    <ul>
                      {f.values.map((v) => (
                        <li>{v}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </div>

    {/* The one piece of glass on this page. It is the only floating control,
        so it stays special. */}
    <a class="case__next glass" href={`/work/${next.id}/`} data-magnetic>
      <span class="case__next-label t-mono">Next</span>
      <span class="case__next-title">{next.data.title}</span>
      <span class="case__next-arrow" aria-hidden="true">&#8594;</span>
    </a>
  </article>
</Base>

<style>
  .case {
    padding-block: calc(var(--s-24) + 2rem) var(--sp-section);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--s-12);
    color: var(--bone-55);
    transition: color var(--d-base) var(--e-out);
  }

  .case__back:hover {
    color: var(--bone);
  }

  /* --- Head -------------------------------------------------------------- */
  .case__head {
    max-width: 46rem;
    margin-bottom: var(--s-12);
    /* The cover below morphs in via a shared view-transition (desktop) or a
       plain cross-fade (mobile, see WorkRow.astro) — either way it's still
       moving into its final position for a few hundred ms after the page
       is technically "loaded". The view-transition overlay that carries it
       renders in the browser's top layer, above all normal page content
       regardless of DOM order or z-index, so text sitting here at full
       opacity from the first frame gets visibly swept over as the image
       travels past on its way to its resting spot. Holding the header back
       until that's done — same soft fade-up the hero uses — means there's
       nothing here yet for the image to cover. */
    opacity: 0;
    transform: translateY(0.6rem);
    animation: case-head-in 700ms var(--e-out) 450ms forwards;
  }

  @keyframes case-head-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case__head {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--s-4);
  }

  .case__discipline {
    color: var(--bone);
  }

  .case__slash {
    color: var(--bone-55);
  }

  .case__title {
    margin-bottom: var(--s-4);
  }

  /* --- Cover ------------------------------------------------------------- */
  /* A fixed-height stage rather than an aspect-ratio box: real covers here
     all exceed the height cap at shell width regardless of their own ratio
     (even the widest, 16:9 retro-racer, needs more height than the cap
     allows), so a fixed height matches what every current cover already
     renders as while staying simple to reason about. .case__cover-frame
     below is what actually holds and sizes the image. */
  .case__cover {
    margin-bottom: var(--sp-section);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: clamp(22rem, 46vw, 40rem);
    /* True black, not --surface-01 — a "recessed panel" grey reads as a
       visible box the moment it letterboxes a square cover, since even a
       10-in-255 lift off pure black is obvious against a solid true-black
       page. Matching --void lets the pillars disappear into the page. */
    background: var(--void);
  }

  /* Sized to the cover's own ratio, shrinking to fit the stage rather than
     filling it and letterboxing internally — the square icon marks (SimBot,
     DUB→ZAZ, H&J Cabinets) were getting their logos sliced off by a forced
     21:9 object-fit: cover, and a full-width box with internal letterboxing
     made the shared-element morph mismatch the home page card's own
     tightly-fit shape (see WorkRow.astro's .work__media), which showed up as
     the image jumping to its letterboxed layout the instant the transition
     started. The border-radius/shadow/overflow that used to live on
     .case__cover move here too, so both ends of the morph carry the same
     "card" chrome rather than it popping in or out mid-transition. */
  .case__cover-frame {
    position: relative;
    height: 100%;
    width: auto;
    max-width: 100%;
    aspect-ratio: var(--arn, 21 / 9);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow:
      var(--shadow-inset),
      var(--shadow-ambient);
  }

  .case__cover-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: saturate(0.88) brightness(0.9);
  }

  /* --- Body -------------------------------------------------------------- */
  .case__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  /* --- Facts rail --------------------------------------------------------- */
  .case__facts {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: var(--surface-00);
    box-shadow:
      0 1px 0 rgba(237, 232, 224, 0.04) inset,
      0 -1px 0 rgba(0, 0, 0, 0.8) inset;
  }

  .case__facts dl {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .fact dt {
    margin-bottom: var(--s-2);
    color: var(--bone-55);
  }

  .fact dd ul {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .fact dd li {
    font-size: var(--t-meta);
    color: var(--bone-70);
  }

  /* --- Next navigator ------------------------------------------------------ */
  .case__next {
    position: fixed;
    right: var(--gutter);
    bottom: var(--s-8);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: 0.9rem 1.2rem;
    border-radius: var(--r-lg);
  }

  .case__next-label {
    color: var(--bone-55);
  }

  .case__next-title {
    font-family: var(--font-display);
    font-weight: 580;
    letter-spacing: -0.01em;
    color: var(--bone);
  }

  .case__next-arrow {
    color: var(--bone-55);
    transition: transform var(--d-base) var(--e-out);
  }

  .case__next:hover .case__next-arrow {
    transform: translateX(0.3rem);
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 62rem) {
    .case__body {
      grid-template-columns: 1fr;
    }

    .case__facts {
      position: static;
      order: -1;
    }

    .case__cover {
      height: clamp(18rem, 80vw, 28rem);
    }
  }

  @media (max-width: 48rem) {
    /* The nav pill owns the bottom of the screen on phones, so the navigator
       becomes an inline block at the end of the article instead. */
    .case__next {
      position: static;
      margin-top: var(--s-16);
      margin-inline: var(--gutter);
      justify-content: space-between;
    }
  }
</style>

<style is:global>
  /* --- MDX prose -----------------------------------------------------------
     Case study blocks are separated by rules rather than cards: this is a
     document, and boxing every paragraph would be the glass-on-everything
     mistake in another form. */
  .prose section + section {
    margin-top: var(--s-12);
    padding-top: var(--s-12);
    border-top: 1px solid var(--bone-08);
  }

  .prose section > .t-mono {
    display: block;
    margin-bottom: var(--s-3);
    color: var(--bone-55);
  }

  .prose h2 {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings: 'wdth' 104;
    letter-spacing: var(--ls-h3);
    line-height: 1.3;
    color: var(--bone);
    margin-bottom: var(--s-4);
  }

  .prose p {
    max-width: 68ch;
    color: var(--bone-70);
    text-wrap: pretty;
  }

  .prose p + p {
    margin-top: var(--s-4);
  }

  .prose figure {
    margin-top: var(--s-6);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface-01);
    box-shadow:
      var(--shadow-inset),
      var(--shadow-ambient);
  }

  .prose figure img {
    width: 100%;
    height: auto;
    filter: saturate(0.9) brightness(0.9);
    transition: filter var(--d-slow) var(--e-out);
  }

  .prose figure:hover img {
    filter: saturate(1) brightness(1);
  }
</style>
