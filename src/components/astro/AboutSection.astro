---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import portrait from '../../assets/about/portrait.webp';

/* Prose ported verbatim from the about card on the old index.html. */
const honors = [
  { label: "Dean's List", detail: 'UC Irvine' },
  { label: 'Scholar-Athlete', detail: 'Division I' },
  { label: '1st Place', detail: 'UCI Video Game Design Competition' },
];
---

<section class="section" id="about" aria-labelledby="about-label">
  <div class="shell">
    <SectionHead label="About" id="about-label" />

    <div class="about">
      <div class="about__prose">
        {/* Condensed stand-in for the three paragraphs below, mobile only —
            see .about__summary in the styles. */}
        <p class="t-lead about__summary">
          Computer Science graduate of UC Irvine (Game Design minor) and Software
          Development Engineer with experience building distributed systems and AI tooling
          for financial infrastructure. Former Division I scholar-athlete.
        </p>

        <p class="t-lead about__full">
          Computer Science graduate of UC Irvine's Donald Bren School of ICS, with a minor
          in Game Design. Software Development Engineer with experience building and
          maintaining scalable distributed systems and AI-powered tooling for financial
          infrastructure handling hundreds of millions of daily transactions.
        </p>
        <p class="t-body about__full">
          I'm drawn to the intersection of engineering scale and creative craft: whether
          that's architecting event-driven pipelines on AWS, leading a game team to win a
          design competition, or pushing the limits of what LLMs can do in production.
          I've worked across cloud infrastructure, full-stack development, machine
          learning, and game development, and I find the most interesting problems tend to
          live where those disciplines overlap.
        </p>
        <p class="t-body about__full">
          Outside of engineering, I competed as a Division I athlete, an experience that
          shaped how I think about team dynamics, composure under pressure, and showing up
          consistently. Dean's List, Scholar-Athlete, and 1st Place at the UC Irvine Video
          Game Design Competition.
        </p>
      </div>

      <aside class="about__side">
        <figure class="portrait">
          <Image
            src={portrait}
            alt="Whittaker Worland"
            widths={[320, 560]}
            sizes="(min-width: 60rem) 22rem, 60vw"
            loading="lazy"
            decoding="async"
            class="portrait__img"
          />
        </figure>

        {/* Small debossed plaques rather than badges or skill bars — each one
            names something that actually happened. */}
        <ul class="plaques">
          {
            honors.map((h) => (
              <li class="plaque">
                <span class="plaque__label engraved">{h.label}</span>
                <span class="plaque__detail t-mono">{h.detail}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .about__prose > * + * {
    margin-top: var(--s-6);
  }

  /* Desktop reads the full three paragraphs; mobile gets the one-line
     stand-in instead — swapped below the 60rem breakpoint that already
     governs this section's mobile layout. */
  .about__summary {
    display: none;
  }

  .about__side {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* --- Portrait ---------------------------------------------------------
     Set into the page rather than sitting on it: the frame is recessed and
     the image itself is held back so a face doesn't out-shout the type. */
  .portrait {
    position: relative;
    /* Capped deliberately. At full column width the photograph out-shouts
       the prose, which is the actual content of this section. */
    max-width: 16rem;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface-01);
    box-shadow:
      0 1px 0 rgba(237, 232, 224, 0.06) inset,
      0 0 0 1px rgba(0, 0, 0, 0.8),
      var(--shadow-ambient);
  }

  .portrait__img {
    width: 100%;
    /* Required: <Image> emits width/height attributes, and without an explicit
       auto height the attribute height wins and aspect-ratio never resolves. */
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    /* A light hold-back rather than the old hover-to-reveal treatment: full
       raw brightness read as too hot against the rest of the page's
       restrained palette, but the photo should still read clearly at rest,
       not dimmed down and waiting for a hover no touch device will ever
       trigger. */
    filter: grayscale(0.25) brightness(0.92) contrast(1.02);
  }

  /* --- Plaques ----------------------------------------------------------- */
  .plaques {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .plaque {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--s-4);
    border-radius: var(--r-sm);
    background: var(--surface-00);
    /* Inverted lighting: dark at the top edge, light at the bottom — the
       surface reads as pressed into the page. */
    box-shadow:
      0 1px 0 rgba(237, 232, 224, 0.05),
      0 -1px 0 rgba(0, 0, 0, 0.85) inset,
      0 1px 2px rgba(0, 0, 0, 0.6) inset;
  }

  .plaque__label {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--bone-70);
  }

  .plaque__detail {
    color: var(--bone-55);
    font-size: 0.6875rem;
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__summary {
      display: block;
    }

    .about__full {
      display: none;
    }

    .about__side {
      flex-direction: row;
      align-items: flex-start;
    }

    .portrait {
      flex: 0 0 40%;
    }

    .plaques {
      flex: 1;
    }
  }

  @media (max-width: 40rem) {
    .about__side {
      flex-direction: column;
    }

    .portrait {
      max-width: 14rem;
    }
  }
</style>
