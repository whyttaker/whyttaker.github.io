---
import { site, links } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <span class="footer__mark t-mono">{site.monogram}</span>
    <nav class="footer__links" aria-label="Elsewhere">
      {
        links.map((l) => (
          <a class="footer__link t-mono" href={l.href} target="_blank" rel="noreferrer noopener">
            {l.label}
          </a>
        ))
      }
    </nav>
    <span class="footer__meta t-mono">{site.location} · {year}</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--bone-08);
    padding-block: var(--s-8);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--bone-55);
  }

  .footer__links {
    display: flex;
    gap: var(--s-6);
  }

  .footer__link {
    transition: color var(--d-base) var(--e-out);
  }

  .footer__link:hover {
    color: var(--bone);
  }
</style>
