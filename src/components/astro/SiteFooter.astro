---
import { site } from '../../data/site';
---

<footer class="footer">
  <div class="shell footer__inner">
    {/* href="/#hero" rides the same in-page anchor handler every other nav
        link uses (see smooth-scroll.ts) — Lenis smoothly scrolls back to
        the hero on the home page; from any other page it's a normal
        navigation to the home page landing on the hero, same as clicking
        the nav's own WW mark. */}
    <a class="footer__mark t-mono" href="/#hero" aria-label={`${site.monogram}, back to top`}>
      {site.monogram}
    </a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--bone-08);
    margin-top: var(--s-16);
    padding-block: var(--s-12);
  }

  .footer__inner {
    display: flex;
    justify-content: center;
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--bone-55);
    transition: color var(--d-base) var(--e-out);
  }

  .footer__mark:hover,
  .footer__mark:focus-visible {
    color: var(--bone);
  }
</style>
