---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { computeRowTiming, REVEAL_DURATION_MS } from '../../lib/work-reveal';

interface Props {
  project: CollectionEntry<'projects'>;
  /* When this row's reveal begins, in ms since page load — see
     work-reveal.ts. WorkSection.astro hands each row the point its
     predecessor's own reveal finishes, so rows play project by project
     down the page rather than all firing at once. */
  startOffsetMs: number;
}

const { project: p, startOffsetMs } = Astro.props;

/* Everything in this row — eyebrow, title, thesis, role, outcome, skills,
   CTA, and the cover image — fades up together at the same delay, once the
   cover has settled into place. The timing math itself lives in
   work-reveal.ts, shared with WorkSection.astro, which needs the identical
   formula to know how long this row's reveal takes before handing the next
   row its own startOffsetMs. */
const { revealDelayMs } = computeRowTiming(startOffsetMs);
---

<li class="work__row" id={p.id} data-work-row={p.id}>
  <a
    class="work__link"
    href={`/work/${p.id}/`}
    style={`--reveal-delay: ${revealDelayMs}ms; --reveal-duration: ${REVEAL_DURATION_MS}ms`}
  >
    {/* Paired with the same name on the case study cover, so the
        image morphs across the navigation rather than reloading. */}
    <div
      class="work__media"
      style={`view-transition-name: cover-${p.id}; --arn: ${(p.data.cover.width / p.data.cover.height).toFixed(4)}`}
    >
      <Image
        src={p.data.cover}
        alt={p.data.coverAlt}
        widths={[480, 768, 1100]}
        sizes="(min-width: 60rem) 46vw, 92vw"
        loading="lazy"
        decoding="async"
        class="work__img"
      />
      <span class="work__sheen" aria-hidden="true" />
    </div>

    <div class="work__body">
      <p class="work__eyebrow t-mono">
        <span class="work__discipline">{p.data.discipline}</span>
        <span class="work__slash" aria-hidden="true">
          /
        </span>
        <span>{p.data.context}</span>
      </p>

      <h3 class="work__title t-h2">{p.data.title}</h3>

      <p class="work__thesis t-lead">{p.data.thesis}</p>

      <dl class="work__facts">
        <div class="work__fact work__fact--role">
          <dt class="t-mono">Role</dt>
          <dd>{p.data.role}</dd>
        </div>
        <div class="work__fact work__fact--outcome">
          <dt class="t-mono">Outcome</dt>
          <dd class="work__outcome">{p.data.outcome}</dd>
        </div>
      </dl>

      <ul class="work__stack">
        {p.data.tags.map((t) => (
          <li class="chip t-mono">{t}</li>
        ))}
      </ul>

      <span class="work__cta t-mono">
        Read more
        <span class="work__arrow" aria-hidden="true">
          &#8594;
        </span>
      </span>
    </div>
  </a>
</li>

<style>
  /* The media column sizes to the image rather than to a fraction. Now that
     images keep their own aspect ratio they no longer fill a fr column, and a
     fixed fraction left a dead gap between picture and text. */
  .work__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  /* --- Media ------------------------------------------------------------ */
  /* Height is the constant across rows and width follows each image's own
     aspect ratio. Forcing a 4:3 box meant object-fit: cover was slicing the
     top and bottom off the square covers. */
  .work__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    /* True black, not --surface-01 — the covers have transparent
       backgrounds, so a "recessed panel" grey shows through as a visible
       box against the page's true-black background instead of disappearing
       into it. Same reasoning as .case__cover on the case study page. */
    background: var(--void);
    box-shadow:
      var(--shadow-inset),
      var(--shadow-ambient);
    /* Width is computed from the ratio rather than left to `auto`. In an
       auto-sized grid track the image's intrinsic 662px drove the track width,
       so the column stayed wide and left a dead gap next to the picture. */
    --h: clamp(15rem, 27vw, 24rem);
    height: var(--h);
    width: calc(var(--h) * var(--arn, 1));
    max-width: 100%;
    aspect-ratio: var(--arn, 1);
    /* Slides in from whichever side it actually sits on (WorkSection.astro's
       alternating layout overrides --media-enter-x to the opposite sign for
       rows where .work__media sits on the right), at the same delay as the
       rest of the row — image and text arrive together. */
    --media-enter-x: -1.5rem;
    opacity: 0;
    transform: translateX(var(--media-enter-x));
    animation: work-media-in var(--reveal-duration) var(--e-out) forwards;
    animation-delay: var(--reveal-delay);
  }

  @keyframes work-media-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The row currently landed on via the back-navigation FLIP (see
     cover-flip.ts and Base.astro's settle() script) already has its own
     JS-driven shrink-into-place animation for this exact element — this
     reveal would otherwise fight it for control of opacity/transform. :target
     matches by URL fragment, the same signal the FLIP script itself keys
     off, so no JS coordination is needed here. */
  .work__row:target .work__media {
    opacity: 1;
    transform: none;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .work__media {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .work__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Images start slightly desaturated and dim so the page reads as one dark
       composition; hover restores them. Colour is earned, not given. */
    filter: saturate(0.72) brightness(0.78) contrast(1.04);
    transform: scale(1.02);
    transition:
      filter var(--d-slow) var(--e-out),
      transform var(--d-slow) var(--e-out);
  }

  .work__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55),
      transparent 45%
    );
    pointer-events: none;
  }

  .work__link:hover .work__img,
  .work__link:focus-visible .work__img {
    filter: saturate(1) brightness(0.95) contrast(1);
    transform: scale(1.045);
  }

  /* --- Body ------------------------------------------------------------- */
  /* Same reasoning as .case__head on the case study page: the shared-element
     cover is still animating into this row's media slot for a few hundred ms
     after the home page has "loaded" (most visibly on the way back from a
     case study, where the cover is shrinking down from full-bleed into this
     card), and that overlay renders above normal page content regardless of
     DOM order. Holding the text back until the group animation settles, then
     fading it up, means there's nothing here yet for the image to sweep
     across. Eyebrow, title, thesis, role, outcome, skills and the CTA all
     fade up together at --reveal-delay (set on .work__link, inherited
     down, from the frontmatter) — one arrival rather than a sequence. */
  .work__eyebrow,
  .work__title,
  .work__thesis,
  .work__fact--role,
  .work__fact--outcome,
  .work__stack,
  .work__cta {
    opacity: 0;
    transform: translateY(0.5rem);
    animation: work-fade-in var(--reveal-duration) var(--e-out) forwards;
    animation-delay: var(--reveal-delay);
  }

  .work__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--s-4);
  }

  @keyframes work-fade-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__eyebrow,
    .work__title,
    .work__thesis,
    .work__fact--role,
    .work__fact--outcome,
    .work__stack,
    .work__cta {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .work__discipline {
    color: var(--bone);
  }

  .work__slash {
    color: var(--bone-55);
  }

  .work__title {
    margin-bottom: var(--s-3);
  }

  .work__thesis {
    margin-bottom: var(--s-6);
  }

  .work__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-bottom: var(--s-6);
    padding-block: var(--s-4);
    border-block: 1px solid var(--bone-08);
  }

  .work__fact dt {
    margin-bottom: 0.35rem;
    color: var(--bone-55);
  }

  .work__fact dd {
    font-size: var(--t-meta);
    color: var(--bone-70);
  }

  .work__outcome {
    color: var(--bone);
  }

  .work__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-6);
  }

  .chip {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--bone-08);
    border-radius: var(--r-sm);
    background: var(--surface-01);
    color: var(--bone-55);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .work__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--bone);
  }

  .work__arrow {
    display: inline-block;
    transition: transform var(--d-base) var(--e-out);
  }

  .work__link:hover .work__arrow,
  .work__link:focus-visible .work__arrow {
    transform: translateX(0.35rem);
  }

  /* --- Responsive ------------------------------------------------------- */
  @media (max-width: 60rem) {
    /* Each row becomes its own bounded card — a flat stack of text with no
       edges read as one continuous scroll on a phone. The surface and inset
       shadow reuse the same "engraved panel" treatment as .stack__item
       elsewhere on the page, so this reads as the site's existing material
       rather than a new visible-card pattern bolted on for mobile. */
    .work__link {
      grid-template-columns: auto minmax(0, 1fr);
      grid-auto-rows: auto;
      /* Row 1 holds both the icon (48px) and the title (one line, ~32px) —
         the icon is the taller of the two, so it sets the row's height.
         `center` (not `start`) is what makes the shorter title actually sit
         in the middle of that row instead of pinned to its top edge, which
         is what centers the two against each other rather than against the
         row bounds alone. Thesis/facts/stack/cta are each solo in their own
         row further down, where start vs center makes no visible difference
         — a row sized by a single item is already exactly that item's
         height, so this doesn't shift anything below the header. */
      align-items: center;
      column-gap: var(--s-4);
      row-gap: 0;
      padding: var(--s-6);
      border-radius: var(--r-md);
      background: var(--surface-01);
      box-shadow:
        0 -1px 0 rgba(0, 0, 0, 0.9) inset,
        0 1px 0 rgba(237, 232, 224, 0.045);
    }

    /* Unwraps .work__body so the eyebrow and title can be placed beside the
       thumbnail while thesis/facts/stack/cta span the full card width below
       — without touching DOM order or the desktop grid, which still only
       ever addresses .work__media and .work__body as .work__link's two
       children. */
    .work__body {
      display: contents;
    }

    /* The mark sits to the left of the title, not above the card — small
       enough to read as an icon next to the name rather than a screenshot
       of the thing. Only one header row now that the eyebrow is hidden, so
       it spans just the title's row. */
    .work__media {
      grid-column: 1;
      grid-row: 1;
      --h: clamp(3rem, 9vw, 4rem);
      box-shadow: var(--shadow-inset);
      /* Same reasoning as dropping the shared-element morph below: at icon
         size a slide-in reads as a small graphic twitching next to the
         text beside it, so the horizontal entrance is dropped — but it
         still fades in on the row's own --reveal-delay same as everything
         else in it, rather than every row's icon being visible up front
         regardless of whose turn it is in the project-by-project cascade. */
      --media-enter-x: 0;
    }

    /* The bottom-fade sheen exists so text overlaid on a full-size banner
       stays readable. At icon size nothing sits on top of the image, so the
       gradient just muddies a very small graphic. */
    .work__sheen {
      display: none;
    }

    /* The discipline/context line and the tag chips are card metadata —
       useful on desktop where there's room, redundant weight on a phone
       where the title and thesis already carry the read. */
    .work__eyebrow,
    .work__stack {
      display: none;
    }

    .work__title {
      grid-column: 2;
      grid-row: 1;
      /* align-items: center (above) centers each row-1 item's MARGIN box,
         not just its content — title's own margin-bottom (kept on desktop
         for the gap before the thesis paragraph) was counting toward that
         box and skewing the title off-center against the icon. Zeroed here
         and made up on .work__thesis's margin-top instead, which is solo in
         its own row and so doesn't feed back into this alignment at all. */
      margin-bottom: 0;
    }

    .work__thesis {
      grid-column: 1 / -1;
      grid-row: 2;
      /* s-3 restores what .work__title's margin-bottom used to contribute
         to this gap, now that it's been zeroed above; s-4 is this rule's
         own original top margin. */
      margin-top: calc(var(--s-3) + var(--s-4));
      margin-bottom: var(--s-4);
    }

    /* Role and Outcome no longer share a row. Wrapped side by side with no
       minimum width, a long outcome (several run 60-80 characters) squeezed
       into half the column and wrapped across many narrow lines next to a
       short one-line Role — dense and harder to read than giving each fact
       the full width. */
    .work__facts {
      grid-column: 1 / -1;
      grid-row: 3;
      flex-direction: column;
      gap: var(--s-3);
      padding-block: var(--s-3);
      margin-bottom: var(--s-4);
    }

    .work__cta {
      grid-column: 1 / -1;
      grid-row: 4;
    }
  }
</style>
