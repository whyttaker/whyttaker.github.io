---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import WorkRow from './WorkRow.astro';
import { computeRowTiming, ROW_GAP_MS } from '../../lib/work-reveal';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const professional = allProjects.filter((p) => p.data.category === 'professional');
const personal = allProjects.filter((p) => p.data.category === 'personal');

/* Each row's reveal starts only once the previous one has fully finished
   (see work-reveal.ts) — project by project down the page, professional
   list into personal, rather than every row animating at once. */
let cursorMs = 0;
function nextStartOffset(): number {
  const start = cursorMs;
  cursorMs = computeRowTiming(start).rowEndMs + ROW_GAP_MS;
  return start;
}
---

<section class="section" id="work">
  <div class="shell">
    {
      professional.length > 0 && (
        <div class="work-group" aria-labelledby="professional-label">
          <SectionHead
            label="Professional Projects"
            id="professional-label"
            count={`${professional.length} roles`}
          />

          <ol class="work" data-work-list="professional">
            {professional.map((p) => (
              <WorkRow project={p} startOffsetMs={nextStartOffset()} />
            ))}
          </ol>
        </div>
      )
    }

    <div class="work-group" aria-labelledby="work-label">
      <SectionHead label="Personal Projects" id="work-label" count={`${personal.length} projects`} />

      <ol class="work" data-work-list="personal">
        {personal.map((p) => (
          <WorkRow project={p} startOffsetMs={nextStartOffset()} />
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* A visible break between the two groups without a full page-section gap —
     enough to read as "a new list", not enough to read as "a new page". */
  .work-group + .work-group {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 4.5vw, 4.5rem);
  }

  /* The desktop gap is tuned for full-width alternating rows with a large
     media column; stacked on mobile with a shrunk thumbnail, that much air
     between rows reads as dead space rather than rhythm. Each row is now its
     own bounded card (see WorkRow.astro), so this gap only has to keep
     adjacent cards visibly apart, not carry the whole sense of separation
     on its own. */
  @media (max-width: 60rem) {
    .work {
      gap: clamp(2rem, 7vw, 4rem);
    }
  }

  /* On a hash landing (the back-navigation FLIP — see cover-flip.ts and
     Base.astro's settle() script), :target marks which row that is. Rows
     ahead of it in reading order have already been scrolled past — the
     project-by-project cascade below (see work-reveal.ts) is only
     meaningful for the row the visitor actually landed on and whatever
     comes after it, so those earlier rows just show immediately instead of
     making the visitor wait through a sequence they never see start.
     :has(~ …) reaches later siblings within one list; the .work-group
     variant reaches whole earlier groups (Professional vs Personal are
     separate lists, not siblings of each other) when the target sits in a
     later one. Both are no-ops with no hash present, since nothing matches
     :target then. */
  :global(
    :is(
      .work-group:has(~ .work-group .work__row:target) .work__row,
      .work__row:has(~ .work__row:target)
    )
      :is(
        .work__eyebrow,
        .work__title,
        .work__thesis,
        .work__fact--role,
        .work__fact--outcome,
        .work__stack,
        .work__cta,
        .work__media
      )
  ) {
    opacity: 1;
    transform: none;
    animation: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* Alternate the reading direction so the page has a rhythm instead of a
     column. Only on wide screens — stacked layouts always lead with media. */
  @media (min-width: 60rem) {
    :global([data-work-list='professional'] .work__row:nth-child(even) .work__link) {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    /* --media-enter-x flips the sign of .work__media's own entrance slide
       (see WorkRow.astro) so it comes in from whichever side it actually
       sits on here, rather than always from the left. */
    :global([data-work-list='professional'] .work__row:nth-child(even) .work__media) {
      order: 2;
      justify-self: end;
      --media-enter-x: 1.5rem;
    }

    /* Personal Projects opens on the opposite side from where Professional
       Projects left off — H & J Cabinets' media lands on the left as the
       last professional row, so this list starts on the right instead of
       repeating it across the section break. */
    :global([data-work-list='personal'] .work__row:nth-child(odd) .work__link) {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    :global([data-work-list='personal'] .work__row:nth-child(odd) .work__media) {
      order: 2;
      justify-self: end;
      --media-enter-x: 1.5rem;
    }
  }
</style>
