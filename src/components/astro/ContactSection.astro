---
import SectionHead from './SectionHead.astro';
import { site, links } from '../../data/site';

const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${site.email}`;
// Discord stays in the shared `links` data (footer, resume) — just left out
// of this section's own "Elsewhere" list.
const elsewhere = links.filter((l) => l.label !== 'Discord');
---

<section class="section contact" id="contact" aria-labelledby="contact-label">
  <div class="shell">
    <SectionHead label="Contact" id="contact-label" />

    <div class="contact__grid">
      <div>
        <p class="contact__lede t-h1">
          Open to opportunities and conversations around scalable systems,
          thoughtful products, and solving challenging engineering problems.
        </p>

        <div class="contact__actions">
          <p class="contact__email t-mono">{site.email}</p>
          <div class="contact__buttons">
            <a class="contact__btn" href={`mailto:${site.email}`} data-magnetic>
              Open in Mail
            </a>
            <a
              class="contact__btn"
              href={gmailHref}
              target="_blank"
              rel="noreferrer noopener"
              data-magnetic
            >
              Open in Gmail
              <span class="contact__arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </div>
      </div>

      <dl class="contact__details">
        <div class="contact__detail">
          <dt class="t-mono">Elsewhere</dt>
          <dd>
            <ul class="contact__links">
              {
                elsewhere.map((l) => (
                  <li>
                    <a
                      class="contact__link"
                      href={l.href}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {l.label}
                      <span class="contact__arrow" aria-hidden="true">
                        &#8599;
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>

        <div class="contact__detail">
          <dt class="t-mono">Resume</dt>
          <dd>
            <ul class="contact__links">
              <li>
                <a class="contact__link" href={site.resumePdf} download>
                  Download PDF
                  <span class="contact__arrow" aria-hidden="true">&#8595;</span>
                </a>
              </li>
              <li>
                <a class="contact__link" href="/resume/">
                  View Resume
                  <span class="contact__arrow" aria-hidden="true">&#8594;</span>
                </a>
              </li>
            </ul>
          </dd>
        </div>

        <div class="contact__detail">
          <dt class="t-mono">Based in</dt>
          <dd class="contact__plain">{site.location}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contact__lede {
    /* max-width alone didn't do anything here: the grid column (not the
       ch-based cap) was already the binding constraint at t-h1's size, so
       the longer copy this now holds still wrapped into 7 short lines and
       towered over the rest of the section. Sized down from t-h1 instead —
       still a bold lede, just proportioned for a full sentence rather than
       a short punchy line. */
    font-size: clamp(2rem, 4vw, 3.25rem);
    max-width: 34ch;
    margin-bottom: var(--s-12);
  }

  /* --- Contact actions -----------------------------------------------------
     Two explicit mail actions instead of copy-to-clipboard: a plain mailto
     link (whatever the OS default client is) and a Gmail compose link. Both
     take the same matte, engraved-surface treatment as the rest of the page
     content — flat, not floating chrome like the nav. */
  .contact__email {
    color: var(--bone-55);
    margin-bottom: var(--s-4);
  }

  .contact__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .contact__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-4);
    padding: 0.9rem 1.5rem;
    border-radius: var(--r-pill);
    background: var(--surface-01);
    box-shadow:
      0 -1px 0 rgba(0, 0, 0, 0.9) inset,
      0 1px 0 rgba(237, 232, 224, 0.045);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--bone);
    /* transform itself is owned by [data-magnetic] in global.css, which
       composes the magnetic offset with the --press scale set on :active. */
    transition:
      transform var(--d-fast) var(--e-snap),
      background var(--d-base) var(--e-out),
      box-shadow var(--d-base) var(--e-out);
  }

  .contact__btn:hover,
  .contact__btn:focus-visible {
    background: var(--surface-02);
  }

  /* --- Details ------------------------------------------------------------ */
  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  .contact__detail dt {
    margin-bottom: var(--s-3);
    color: var(--bone-55);
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bone-70);
    transition: color var(--d-base) var(--e-out);
  }

  .contact__link:hover {
    color: var(--bone);
  }

  .contact__arrow {
    color: var(--bone-55);
    transition: transform var(--d-base) var(--e-out);
  }

  .contact__link:hover .contact__arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  .contact__plain {
    color: var(--bone-70);
  }

  @media (max-width: 60rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
