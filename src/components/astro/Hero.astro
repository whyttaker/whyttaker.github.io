---
import { site } from '../../data/site';

/*
  The hero is a canvas of falling glyphs (see scripts/rain/) plus real DOM text
  in front of it.

  The canvas is decorative and aria-hidden. Name, role and description are
  ordinary HTML above it, so the visual can fail completely — no JS, no canvas
  support, a thrown exception — and the hero still says who this is. That
  constraint is why there is no loading state and no layout reserved for
  anything to arrive.

  A no-JS visitor gets the composition below with a plain black field behind
  it, which is a legitimate design rather than a broken one.
*/
---

<section class="hero" id="hero">
  <canvas class="rain" data-rain aria-hidden="true"></canvas>
  {/* The landed name draws here instead of into the storm. The storm canvas
      builds its trails by never clearing, which turns any horizontal movement
      into a smear — fine for falling rain, wrong for letters travelling into
      position. This layer is cleared every frame, so the name stays crisp. */}
  <canvas class="rain rain--name" data-rain-name aria-hidden="true"></canvas>

  <div class="shell hero__content">
    {/* The rain dims behind this block so the display type stays crisp — the
        "hero" value marks this as the one zone that also gets the bespoke
        left-side wash, rather than just the generic pool every other tracked
        block down the page gets. */}
    <div class="hero__type" data-rain-clear="hero">
      <p class="hero__eyebrow t-mono">
        {site.role}
      </p>

      {/* The intro measures these two lines and assembles the name out of the
          rain at exactly their position, size and line break, so the handover
          to the real typeface reads as the glyphs setting rather than as one
          thing being swapped for another. */}
      <h1 class="hero__name t-display">
        <span class="hero__name-line" data-name-line>Whittaker</span>
        <span class="hero__name-line" data-name-line>Worland</span>
      </h1>

      <p class="hero__sub">
        {site.description}<br />
        <span class="hero__school">{site.passion}</span>
      </p>
    </div>

  </div>

  <a class="hero__scroll t-mono" href="#work">
    <span class="hero__scroll-rule" aria-hidden="true"></span>
    <span>Scroll</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: var(--s-32) var(--s-24);
    /* No clip: the rain canvas below is deliberately taller than this box so
       it can fade out a little past the section's own bottom edge instead of
       stopping in a hard line. Nothing else in the hero overflows it. */
  }

  /* Sits below the global grain layer (z-index 1) so the film grain textures
     the rain rather than being hidden by it. */
  .rain {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 0;
    width: 100%;
    /* Runs 100px past the hero's own height and fades out over that span via
       the mask below — real falling glyphs feathering out, not a synthetic
       overlay, so the edge reads as soft and a little uneven rather than a
       geometric cutoff. */
    height: calc(100% + 100px);
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 100px), transparent 100%);
    mask-image: linear-gradient(to bottom, black calc(100% - 100px), transparent 100%);
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--e-out);
  }

  .rain[data-ready] {
    /* --handoff is driven by the scroll store as the hero leaves. */
    opacity: var(--handoff, 1);
  }

  /* Above the storm and above the dimming wash, which sweeps the left of the
     frame — exactly where the name is heading. */
  .rain--name {
    z-index: 2;
    opacity: 1;
    pointer-events: none;
  }

  /* --- Intro -------------------------------------------------------------
     The held-back state is applied to the individual children, never to
     .hero__content itself.

     That container wraps the name, and animating its opacity and transform
     meant the name inherited both: it faded up from 4% and slid 0.6rem
     upwards after the swap, which read as the name fading in out of black and
     then bouncing into place. Its own opacity being instant made no
     difference — a parent's opacity multiplies through.

     Content stays painted rather than hidden, so the largest contentful paint
     is not deferred until the animation ends and a failed script still leaves
     a readable hero. */
  :global(html[data-intro]) .hero__eyebrow,
  :global(html[data-intro]) .hero__sub,
  :global(html[data-intro]) .hero__scroll {
    opacity: 0.04;
    transform: translateY(0.6rem);
  }

  :global(html[data-intro][data-intro-reveal]) .hero__eyebrow,
  :global(html[data-intro][data-intro-reveal]) .hero__sub,
  :global(html[data-intro][data-intro-reveal]) .hero__scroll {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms var(--e-out) 200ms,
      transform 1100ms var(--e-out) 200ms;
  }

  /* The name switches on and does not move. The canvas glyphs sitting on it
     are the same face at the same size on the same baseline, so the swap is
     one set of identical pixels replacing another. Any transition or offset
     here reintroduces exactly the artefact this removes. */
  :global(html[data-intro]) .hero__name {
    opacity: 0;
  }

  :global(html[data-intro][data-intro-reveal]) .hero__name {
    opacity: 1;
    transition: none;
  }

  /* --- Content ---------------------------------------------------------- */
  .hero__content {
    position: relative;
    z-index: 3;
    pointer-events: none;
  }

  .hero__content > * {
    pointer-events: auto;
  }

  .hero__type {
    /* The dimming ellipse is measured from this box, so it must wrap exactly
       the type that needs protecting and nothing else. */
    display: inline-block;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    margin-bottom: var(--s-6);
    color: var(--bone-55);
  }

  .hero__name {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--s-8);
    /* Belt and braces over the dimming ellipse: the type carries its own
       shadow so a bright column passing behind it can never break the read. */
    text-shadow:
      0 2px 30px rgba(0, 0, 0, 0.95),
      0 0 60px rgba(0, 0, 0, 0.8);
  }

  .hero__name-line:last-child {
    margin-left: 0.14em;
  }

  .hero__sub {
    font-size: var(--t-body-lg);
    line-height: 1.5;
    color: var(--bone-70);
    max-width: 34ch;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
  }

  .hero__school {
    color: var(--bone-55);
    font-size: var(--t-meta);
  }

  /* --- Scroll cue ------------------------------------------------------- */
  .hero__scroll {
    position: absolute;
    z-index: 3;
    bottom: var(--s-8);
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-4);
    color: var(--bone-55);
    transition: color var(--d-base) var(--e-out);
  }

  .hero__scroll:hover {
    color: var(--bone);
  }

  .hero__scroll-rule {
    display: block;
    /* Authored at the hover (long) size and scaled down at rest, rather than
       animating width — the gradient's stops are proportional (0%/100%), so
       scaling it renders identically to the old width animation while
       running on the compositor instead of triggering layout every frame. */
    width: 4.5rem;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--bone-22));
    transform: scaleX(0.6667);
    transform-origin: left;
    transition: transform var(--d-slow) var(--e-out);
  }

  .hero__scroll:hover .hero__scroll-rule {
    transform: scaleX(1);
  }

  /* The nav pill owns the bottom of the screen on phones. */
  @media (max-width: 48rem) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-block: var(--s-24) var(--s-16);
    }

    .hero__sub {
      font-size: var(--t-body);
    }
  }
</style>
